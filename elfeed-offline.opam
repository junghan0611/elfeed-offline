# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Offline-first Elfeed (proxy) server with PWA"
description:
  "Dream-based proxy + offline PWA, caches entries and syncs tags."
maintainer: ["Puneeth Chaganti <punchagan@muse-amuse.in>"]
authors: ["Puneeth Chaganti <punchagan@muse-amuse.in>"]
license: "AGPLv3"
tags: ["elfeed" "rss" "feeds" "PWA" "offline" "proxy" "dream"]
homepage: "https://github.com/punchagan/elfeed-offline"
doc: "https://github.com/punchagan/elfeed-offline"
bug-reports: "https://github.com/punchagan/elfeed-offline/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml"
  "dream"
  "cohttp"
  "cohttp-lwt-unix"
  "lwt"
  "brr"
  "uri"
  "uri-sexp"
  "alcotest" {with-test}
  "ptime"
  "astring"
  "lwd"
  "brr-lwd"
  "syndic"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/punchagan/elfeed-offline.git"
x-maintenance-intent: ["(latest)"]
